# Application
APP_NAME=TruthLens AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database (async SQLAlchemy URL)
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/truthlens

# JWT
JWT_SECRET=5vK-FjgPBYiirvMu0aJlO8sv3xF6dc7iDihP6G2QT5U
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Secret Key
SECRET_KEY=942e55a56d758ce424a223a6d298c0f34e90574ca2f44f7172c7a9b20f9e4832

# Gemini API Key (for AI features)
GEMINI_API_KEY=AQ.Ab8RN6IK6RhRteOawkCihfAdVTKCPFh5dqAdsFCovKqe-0U5aQ

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PREDICT=30/minute

# ML model paths (relative to backend root)
ML_MODEL_PATH=app/ml/models/linear_svm_fake_news_model.joblib
ML_VECTORIZER_PATH=app/ml/models/tfidf_vectorizer.joblib

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Email (optional — password reset logs link when SMTP is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@truthlens.ai
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
